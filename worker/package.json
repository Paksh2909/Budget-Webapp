{
  "name": "budget-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply budget-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply budget-db --remote",
    "secrets": "node scripts/generate-secrets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "typescript": "5.9.3",
    "wrangler": "4.157.0"
  }
}
