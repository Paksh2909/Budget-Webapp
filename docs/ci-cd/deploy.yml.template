# TEMPLATE — not active. GitHub only runs workflows in .github/workflows/.
# To enable, follow docs/ci-cd/README.md (copy to .github/workflows/deploy.yml,
# delete .github/workflows/deploy-web.yml, and add the two Cloudflare secrets).

name: Deploy

# One push to main deploys everything, in the order that keeps them compatible:
#   1. D1 migrations  2. Cloudflare Worker  3. Web app on GitHub Pages
on:
  push:
    branches: [main]
    paths:
      - 'web/**'
      - 'worker/**'
      - 'package.json'
      - 'package-lock.json'
      - '.nvmrc'
      - '.github/workflows/deploy.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: deploy
  cancel-in-progress: false

jobs:
  worker:
    name: Migrate database & deploy Worker
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - name: Check Cloudflare credentials
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          if [ -z "$CLOUDFLARE_API_TOKEN" ] || [ -z "$CLOUDFLARE_ACCOUNT_ID" ]; then
            echo "::error::Add CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID under Settings > Secrets and variables > Actions > Secrets."
            exit 1
          fi
      - name: Apply D1 migrations
        working-directory: worker
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        # Only runs migrations that haven't been applied yet; a no-op otherwise.
        run: npx wrangler d1 migrations apply budget-db --remote
      - name: Deploy Worker
        working-directory: worker
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        # Uploads code + config (vars, cron). Worker secrets set with `wrangler secret put` are kept as-is.
        run: npx wrangler deploy

  build-web:
    name: Build web app
    needs: worker
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - name: Build
        run: npm run build -w web
        env:
          # Your Worker URL, as a repository Variable (preferred) or Secret named VITE_API_URL.
          VITE_API_URL: ${{ vars.VITE_API_URL || secrets.VITE_API_URL }}
          BASE_PATH: /${{ github.event.repository.name }}/
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: web/dist

  deploy-web:
    name: Publish to GitHub Pages
    needs: build-web
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
